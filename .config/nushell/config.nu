# thefuck --alias emits bash/zsh code; invoke `thefuck` directly instead.
$env.config.edit_mode = 'vi'

alias newdb = nvim ~/.config/gobang/config.toml
alias nv = nvim .
alias ytdl = yt-dlp
def erc [] { nvim $nu.config-path }
def epr [] { nvim $nu.env-path }
alias lg = lazygit
alias ld = lazydocker
alias oc = opencode
alias cr = tuicr

def reload [] {
    exec nu --env-config $nu.env-path --config $nu.config-path -l
}

def cb [] {
    ^./stop
    if $env.LAST_EXIT_CODE != 0 { error make {msg: './stop failed'} }
    ^./build
    if $env.LAST_EXIT_CODE != 0 { error make {msg: './build failed'} }
    ^./start
}

# Generated by env.nu; zoxide's default commands are z and zi.
source ~/.zoxide.nu
