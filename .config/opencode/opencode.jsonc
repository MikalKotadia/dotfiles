{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-mermaid-renderer@0.0.3",
    "@mohak34/opencode-notifier@0.2.8",
    "oh-my-opencode-slim"
  ],
  "layout": "stretch",
  "autoupdate": true,
  "tools": {
    "background_task": false,
    "background_output": false,
    "background_cancel": false
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "question": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "provider": {},
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}
