{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "keybinds": {
    "session.child.next": "<leader>right",
    "session.child.previous": "<leader>left",
    "session.background": "<leader>z",
    "input.move.left": "left",
    "diff.page.up": "pageup"
  },
  "tabs": {
    "mode": "off"
  },
  "plugins": [
    "oh-my-opencode-slim",
    "opencode-vim@latest"
  ],
  "attention": {
    "enabled": true,
    "notifications": false,
    "sound": true
  },
  "prompt": {
    "image_preview": true
  }
}
