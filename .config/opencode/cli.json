{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "keybinds": {
    "session.child.next": "<leader>right",
    "session.child.previous": "<leader>left"
  },
  "plugins": [
    "oh-my-opencode-slim",
    "opencode-vim@latest"
  ],
  "attention": {
    "enabled": true,
    "notifications": false,
    "sound": true
  }
}
